<figure class="quote">
    <figcaption class="quote__cite">{% if delete_quote == false %}<span class="quote__date">{{ quote.date|raw }}</span>{% endif %}
        {{ quote.username }} {{ lang.wrote }} {% if quote.linkback %}<cite><a href="{{ quote.url }}" class="quote__jump">{{ include('partials/icon.twig', {icon: 'level-up-alt', class: 'icon icon--subdued icon--link'}, with_context = false) }}</a></cite>{% endif %}</figcaption>
    <blockquote class="post__quote" {% if quote.linkback %}cite="{{ quote.url }}"{% endif %}>
        {{ quote.message|raw }}
    </blockquote>
</figure>
