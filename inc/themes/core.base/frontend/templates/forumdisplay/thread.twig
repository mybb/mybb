<div class="row row--thread thread thread--default inline_row
    {% if thread.unreadpost and thread.moved == 0 %} thread--unread{% endif %}
    {% if thread.sticky %} thread--sticky{% endif %}
    {% if modpermissions.ismod %} thread--moderator{% endif %}
    {% if thread.visible == -1 and modpermissions.canviewdeleted %} thread--deleted{% endif %}
    {% if thread.visible == 0 %} thread--awaiting-approval{% endif %}">
    <div class="thread__title">
        {# Thread prefix #}
        {% if thread.threadprefix %}
            <span class="thread__prefix thread-prefix thread-prefix--prefix-{{ thread.prefix }}">
                <a href="{{ url(get_forum_link(thread.fid), {prefix: thread.prefix}) }}">{{ thread.threadprefix|raw }}</a>
            </span>
        {% endif %}
        <h3 class="thread__subject">
            {# Thread title #}
            <span class="{{ thread.inlineEditClass }} {{ thread.newclass }}" id="tid_{{ thread.tid }}">
                <a href="{{ get_thread_link(thread.tid) }}">{{ thread.subject }}</a>
            </span>
        </h3>
        {# Deleted thread #}
        {% if thread.visible == -1 %}
            <span class="thread__status tag tag--thread-status tag--deleted">{{ lang.deleted_thread }}</span>
        {% endif %}

        {% if thread.visible == 0 %}
            <span class="thread__status tag tag--thread-status tag--awaiting-approval">{{ lang.awaiting_approval }}</span>
        {% endif %}

        {# Go to unread link #}
        {% if thread.unreadpost and thread.moved == 0 %}
            <a href="{{ thread.newpostlink }}" class="thread__jump">
                {{ include('partials/icon.twig', {icon: 'circle', class: 'fa-fw', title: lang.goto_first_unread}, with_context = false) }}
            </a>
        {% endif %}
    </div>
    {# Thread status icons #}
    <div class="thread__icons">
        {# Thread icon #}
        {% if thread.icon and iconCache[thread.icon] %}
            <span class="thread__icon"><img src="{{ iconCache[thread.icon].path }}" alt="{{ iconCache[thread.icon].name }}" title="{{ iconCache[thread.icon].name }}" /></span>
        {% endif %}

        {# Contains posts by you #}
        {% if 'dot' in thread.folder.value %}
            {{ include('partials/icon.twig', {icon: 'user-circle', class: 'thread__icon thread__icon--contains-you fa-fw', title: lang.posts_by_you}, with_context = false) }}
        {% endif %}

        {# Attachment paperclip #}
        {% if mybb.settings.enableattachments and thread.attachmentcount %}
            {% set attachment_title = (thread.attachmentcount > 1) ? trans('attachment_count_multiple', thread.attachmentcount) : lang.attachment_count %}
            {{ include('partials/icon.twig', {icon: 'paperclip', class: 'thread__icon thread__icon--attachment fa-fw', title: attachment_title}, with_context = false) }}
        {% endif %}

        {# Hot thread #}
        {% if 'hot' in thread.folder.value %}
            {{ include('partials/icon.twig', {icon: 'fire', class: 'thread__icon thread__icon--hot fa-fw', title: lang.hot}, with_context = false) }}
        {% endif %}

        {# Poll #}
        {% if thread.poll %}
            {{ include('partials/icon.twig', {icon: 'check-square', class: 'thread__icon thread__icon--poll fa-fw', title: lang.poll_prefix}, with_context = false) }}
        {% endif %}

        {# Moved #}
        {% if thread.moved %}
            {{ include('partials/icon.twig', {icon: 'arrow-right', class: 'thread__icon thread__icon--moved fa-fw', title: lang.moved_prefix}, with_context = false) }}
        {% endif %}

        {# Closed #}
        {% if thread.closed %}
            {{ include('partials/icon.twig', {icon: 'lock', class: 'thread__icon thread__icon--closed fa-fw', title: lang.closed}, with_context = false) }}
        {% endif %}

        {# Sticky #}
        {% if thread.sticky %}
            {{ include('partials/icon.twig', {icon: 'thumbtack', class: 'thread__icon thread__icon--sticky fa-fw', title: lang.sticky}, with_context = false) }}
        {% endif %}
    </div>
    <div class="thread__author">
        {{ lang.by }}
        <span class="thread__overflow">
            {% if thread.uid > 0 %}
                <a href="{{ get_profile_link(thread.uid) }}">{{ thread.uid|format_name }}</a>
            {% else %}
                {{ thread.threadusername ?? lang.guest }}
            {% endif %}
        </span>
        {{ thread.dateline|my_date }}
    </div>
    {% if thread.posts > mybb.settings.postsperpage %}
        <div class="thread__pages">
            <span class="thread__page-legend">{{ lang.pages }}</span>
            {% set pagesBegin = thread.pages - 2 %}
            {% for page in pagesBegin..thread.pages %}
                {% if page > 1 %}
                    <a href="{{ get_thread_link(thread.tid, page) }}" class="thread__page-link">{{ page }}</a>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}

    <div class="thread__replies thread__count thread__count--replies">
        <a href="{{ url('misc.php', {action: 'whoposted', tid: thread.tid}) }}" onclick="MyBB.whoPosted({{ thread.tid }}); return false;" class="thread__reply-count">{{ thread.replies }}</a>
        <span class="thread__legend">{% if thread.replies == 1 %}{{ lang.reply }}{% else %}{{ lang.replies }}{% endif %}</span>
        {% if thread.unapprovedposts and modpermissions.canviewunapprove %}
            <span class="thread__unapproved-replies" title="{{ (thread.unapprovedposts == 1) ? trans('thread_unapproved_post_count', 1) : trans('thread_unapproved_posts_count', thread.unapprovedposts) }}">
                {{ thread.unapprovedposts|my_number_format }}
            </span>
        {% endif %}
    </div>
    <div class="thread__views thread__count thread__count--views">
        {{ thread.views }}
        <span class="thread__legend">{% if thread.views == 1 %}{{ lang.view }}{% else %}{{ lang.views }}{% endif %}</span>
    </div>
    <div class="thread__avatar">
        {% if thread.lastposteruid > 0 %}
            <a href="{{ get_profile_link(thread.lastposteruid) }}" class="avatar-profile-link">
                {{ render_avatar(url=thread.last_poster_avatar, alt=thread.last_poster_name, class='avatar--smallest') }}
            </a>
        {% else %}
            {{ render_avatar(url=thread.last_poster_avatar, alt=thread.last_poster_name, class='avatar--smallest') }}
        {% endif %}
    </div>
    <div class="thread__latest latest-post">
        <span class="latest-post__text">{{ lang.lastpost_by }}</span>
        <span class="latest-post__author">
            {% if thread.lastposteruid > 0 %}
                <a href="{{ get_profile_link(thread.lastposteruid) }}">{{ thread.lastposteruid|format_name }}</a>
            {% else %}
                {{ thread.lastposter ?? lang.guest }}
            {% endif %}
        </span>
        <a href="{{ get_thread_link(thread.tid, 0, 'lastpost') }}" class="latest-post__date">{{ thread.lastpost|my_date }}</a>
    </div>

    {% include 'forumdisplay/thread_modbit.twig' %}
</div>
