<div class="row row--thread row--announcement thread thread--default thread--announcement thread--{{ folder }}">
    {# <div class="thread__column thread__column--primary"> #}
    <div class="thread__jump thread__jump--announcement">
        {{ include('partials/icon.twig', {icon: 'bullhorn', class: ''}, with_context = false) }}
    </div>
    <div class="thread__title">
        <h3 class="thread__subject"><a href="{{ announcement.announcementlink }}"{{ new_class }}>{{ announcement.subject }}</a></h3>
        <div class="thread__author">{{ lang.by }} {{ announcement.profilelink|raw }}</div>
        <div class="thread__date">{{ announcement.postdate }}</div>
    </div>
</div>
