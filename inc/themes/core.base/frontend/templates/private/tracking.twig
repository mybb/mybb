{% extends 'layouts/messenger.twig' %}

{% block head %}
    <title>{{ lang.pm_tracking }} - {{ mybb.settings.bbname }}</title>
{% endblock head %}

{% block messengerHeader %}
    <header class="page-header">
        <h1 class="title title--page">{{ lang.pm_tracking }}</h1>
    </header>
{% endblock messengerHeader %}

{% block messengerBody %}
    <section class="block block--thread-list">
        <form action="private.php" method="post">
            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}" />
            <input type="hidden" name="action" value="do_tracking" />
            <h1 class="title title--major">{{ lang.unread_messages }}</h1>
            <div class="column-headings column-headings--minor column-headings--thread-list thread thread--message">
                <div class="column-headings__column thread__title">{{ lang.message_title }}</div>
                <div class="column-headings__column thread__author">{{ lang.sentto }}</div>
                <div class="column-headings__column thread__date">{{ lang.datesent }}</div>
                <div class="column-headings__column thread__checkbox">
                    <input type="checkbox" class="checkbox checkall" name="allbox" />
                </div>
            </div>
            <div class="thread-list thread-list--messages">
                {% for unreadmessage in unreadmessages %}
                    <div class="row row--thread thread thread--message">
                        <div class="thread__avatar">
                            <a href="{{ get_profile_link(unreadmessage.toid) }}" class="avatar-profile-link">
                                {{ render_avatar(url=unreadmessage.to_avatar, alt=unreadmessage.tousername, class='avatar--smallest' ) }}
                            </a>
                        </div>
                        <div class="thread__title">
                            <h3 class="thread__subject">{{ unreadmessage.subject }}</h3>
                        </div>
                        <div class="thread__author">
                            {% if unreadmessage.toid > 0 %}
                                <a href="{{ get_profile_link(unreadmessage.toid) }}">{{ unreadmessage.toid|format_name }}</a>
                            {% else %}
                                {{ unreadmessage.tousername ?? lang.guest }}
                            {% endif %}
                        </div>
                        <div class="thread__date">{{ unreadmessage.senddate|raw }}</div>
                        <div class="thread__checkbox"><input type="checkbox" class="checkbox checkbox--select-row" name="unreadcheck[{{ unreadmessage.pmid }}]" value="1" /></div>
                    </div>
                {% else %}
                    <div class="no-results">{{ lang.no_unreadmessages }}</div>
                {% endfor %}
            </div>
            {% if unreadmessages %}
                <div class="block__footer block-actions block-actions--extra-space">
                    <span class="block-actions__title">{{ lang.with_selected }}</span>
                    <button type="submit" class="button button--inline block-actions__button" name="stoptrackingunread" value="stop">
                        {{ include('partials/icon.twig', {icon: 'ban', class: 'button__icon'}, with_context = false) }}
                        <span class="button__text">{{ lang.stop_tracking }}</span>
                    </button>
                    <button type="submit" class="button button--inline block-actions__button" name="cancel" value="cancel">
                        {{ include('partials/icon.twig', {icon: 'trash', class: 'button__icon'}, with_context = false) }}
                        <span class="button__text">{{ lang.delete }}</span>
                    </button>
                </div>
            {% endif %}
        </form>
    </section>
    {{ unread_multipage|raw }}

    <section class="block block--thread-list">
        <form action="private.php" method="post">
            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}" />
            <input type="hidden" name="action" value="do_tracking" />
            <h1 class="title title--major">{{ lang.read_messages }}</h1>
            <div class="column-headings column-headings--minor column-headings--thread-list thread thread--message">
                <div class="column-headings__column thread__title">{{ lang.message_title }}</div>
                <div class="column-headings__column thread__author">{{ lang.sentto }}</div>
                <div class="column-headings__column thread__date">{{ lang.datesent }}</div>
                <div class="column-headings__column thread__checkbox">
                    <input type="checkbox" class="checkbox checkall" name="allbox" />
                </div>
            </div>
            <div class="thread-list thread-list--messages">
                {% for readmessage in readmessages %}
                    <div class="row row--thread thread thread--message">
                        <div class="thread__avatar">
                            <a href="{{ get_profile_link(readmessage.toid) }}" class="avatar-profile-link">
                                {{ render_avatar(url=readmessage.to_avatar, alt=readmessage.tousername, class='avatar--smallest' ) }}
                            </a>
                        </div>
                        <div class="thread__title">
                            <h3 class="thread__subject">{{ readmessage.subject }}</h3>
                        </div>
                        <div class="thread__author">
                            {% if readmessage.toid > 0 %}
                                <a href="{{ get_profile_link(readmessage.toid) }}">{{ readmessage.toid|format_name }}</a>
                            {% else %}
                                {{ readmessage.tousername ?? lang.guest }}
                            {% endif %}
                        </div>
                        <div class="thread__date">{{ readmessage.readdate|raw }}</div>
                        <div class="thread__checkbox"><input type="checkbox" class="checkbox checkbox--select-row" name="readcheck[{{ readmessage.pmid }}]" value="1" /></div>
                    </div>
                {% else %}
                    <div class="no-results">{{ lang.no_readmessages }}</div>
                {% endfor %}
                {% if readmessages %}
                    <div class="block__footer block-actions block-actions--extra-space">
                        <span class="block-actions__title">{{ lang.with_selected }}</span>
                        <button type="submit" class="button button--inline block-actions__button" name="stoptracking" value="stop">
                            {{ include('partials/icon.twig', {icon: 'ban', class: 'button__icon'}, with_context = false) }}
                            <span class="button__text">{{ lang.stop_tracking }}</span>
                        </button>
                    </div>
                {% endif %}
            </table>
        </form>
    </section>
    {% if readmessages %}
        <div class="page-controls page-controls--compact">
            {{ read_multipage|raw }}
            <div class="page-buttons">
                <a href="private.php?action=stopalltracking&amp;my_post_key={{ mybb.post_code }}" class="button button--secondary button--danger">
                    {{ include('partials/icon.twig', {icon: 'times', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.stop_tracking_all }}</span>
                </a>
            </div>
        </div>
    {% endif %}
    

{% endblock messengerBody %}
