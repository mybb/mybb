<div class="modal">
	<section class="block block--modal referral_modal_{{ uid }}">
		<h2 class="title title--modal">{{ lang.referrals }}</h2>
		<div class="modal__content referrals">
			{% if referral_count <= 0 %}
				{{ lang.member_no_referrals }}
			{% else %}
				<div class="column-headings column-headings--minor referrals__legend">
					<div class="column-headings__column column-headings__column--primary referrals__username">{{ lang.username }}</div>
					<div class="column-headings__column column-headings__column--secondary referrals__date">{{ lang.referral_date }}</div>
				</div>
				{% for referral in referrals %}
					<div class="row row--simple-columns referrals__user">
						<div class="row__primary referrals__username">{{ referral.username|raw }}</div>
						<div class="row__secondary referrals__date">{{ referral.regdate|raw }}</div>
					</div>
				{% endfor %}
			{% endif %}
		</div>
	</section>
</div>