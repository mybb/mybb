{% extends 'layouts/account.twig' %}

{% block head %}
    <title>{{ lang.security_log }} - {{ mybb.settings.bbname }}</title>
{% endblock head %}

{% block accountHeader %}
    <header class="page-header">
        <h1 class="title title--page">{{ lang.security_log }}</h1>
    </header>
{% endblock accountHeader %}

{% block accountBody %}
    <section class="block">
        <div class="column-headings column-headings--major security-log">
            <div class="column-headings__primary security-log__primary">
                {{ lang.security_log_activity }} &mdash; {{ lang.date }}
            </div>
            <div class="column-headings__primary security-log__secondary">
                {{ lang.security_log_ip }}
            </div>
        </div>
        <div class="results">
            {% for security_log in securitylog %}
                <div class="row row--simple-columns security-log">
                    <div class="security-log__primary">
                        <div class="security-log__activity">{{ security_log.information }}</div>
                        <div class="security-log__date">{{ security_log.date|raw }}</div>
                    </div>
                    <div class="security-log__secondary">
                        <div class="security-log__ip">
                            {{ security_log.ipaddress }}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="no-results">{{ lang.no_security_logs }}</div>
            {% endfor %}
        </div>
    </section>
    {{ multipage|raw }}
{% endblock %}
