{% extends 'layouts/account.twig' %}

{% block head %}
    <title>{{ lang.security_log }} - {{ mybb.settings.bbname }}</title>
{% endblock head %}

{% block accountHeader %}
    <header class="page-header">
        <h1 class="title title--page">{{ lang.security_log }}</h1>
    </header>
{% endblock accountHeader %}

{% block accountBody %}
    <section class="block">
        <div class="column-headings column-headings--major column-headings--simple-columns security-log security-log--column-headings">
            <div class="security-log__activity">{{ lang.security_log_activity }}</div>
            <div class="security-log__date">{{ lang.date }}</div>
            <div class="security-log__ip">{{ lang.security_log_ip }}</div>
        </div>
        <div class="results">
            {% for security_log in securitylog %}
                <div class="row row--simple-columns security-log security-log--row">
                    <div class="security-log__activity">{{ security_log.information }}</div>
                    <div class="security-log__date">{{ security_log.date|raw }}</div>
                    <div class="security-log__ip">{{ security_log.ipaddress }}</div>
                </div>
            {% else %}
                <div class="no-results">{{ lang.no_security_logs }}</div>
            {% endfor %}
        </div>
    </section>
    {{ multipage|raw }}
{% endblock %}
