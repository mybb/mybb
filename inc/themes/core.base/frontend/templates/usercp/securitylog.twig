{% extends 'layouts/account.twig' %}

{% block head %}
    <title>{{ lang.security_log }} - {{ mybb.settings.bbname }}</title>
{% endblock head %}

{% block accountHeader %}
    <header class="page-header">
        <h1 class="title title--page">{{ lang.security_log }}</h1>
    </header>
{% endblock accountHeader %}

{% block accountBody %}
    <section class="block">
        <div class="column-headings column-headings--major security-log">
            <div class="column-headings__column column-headings__column--primary column-headings__column--sub-columns">
                <div class="column-headings__sub-column security-log__info security-log__info--activity">{{ lang.security_log_activity }}</div>
                <div class="column-headings__separator">&nbsp;&mdash;&nbsp;</div>
                <div class="column-headings__sub-column security-log__info security-log__info--date">{{ lang.date }}</div>
            </div>
            <div class="column-headings__column column-headings__column--secondary security-log__info security-log__info--ip security-log__info--heading">{{ lang.security_log_ip }}</div>
        </div>
        <div class="results">
            {% for security_log in securitylog %}
                <div class="row row--simple-columns security-log">
                    <div class="row__primary row__primary--sub-columns">
                        <div class="row__sub-column security-log__info security-log__info--activity">{{ security_log.information }}</div>
                        <div class="row__sub-column security-log__info security-log__info--date">{{ security_log.date|raw }}</div>
                    </div>
                    <div class="row__secondary security-log__info security-log__info--ip">{{ security_log.ipaddress }}</div>
                </div>
            {% else %}
                <div class="no-results">{{ lang.no_security_logs }}</div>
            {% endfor %}
        </div>
    </section>
    {{ multipage|raw }}
{% endblock %}
