{# <span class="thread_status {{ thread.folder }}" title="{{ thread.folder_label }}">&nbsp;</span> #}
<div class="row row--thread thread thread--subscription thread--compact">
    <div class="thread__title">
        {% if thread.threadprefix %}
            <span class="thread__prefix thread-prefix thread-prefix--prefix-{{ thread.prefix }}">{{ thread.threadprefix|raw }}</span>
        {% endif %}
        <h3 class="thread__subject {{ new_class }}">
            <a href="{{ thread.threadlink }}" class="{{ thread.new_class }}">{{ thread.subject }}</a>
            {% if thread.lastread and thread.lastpost > thread.lastread %}
                <a href="{{ thread.newpostlink }}" class="thread__jump">
                    {{ include('partials/icon.twig', {icon: 'circle', class: '', title: lang.goto_first_unread}, with_context = false) }}
                </a>
            {% endif %}
        </h3>
    </div>
    <div class="thread__icons">
        {% if thread.icon is iterable %}
            <span class="thread__icon">
                {% if thread.icon.icon_class %}
                    {{ include('partials/icon.twig', {icon: thread.icon.icon_class, class: '', title: thread.icon.name}, with_context = false) }}
                {% elseif thread.icon.path %}
                    <img src="{{ thread.icon.path }}" alt="{{ thread.icon.name }}" title="{{ thread.icon.name }}" />
                {% endif %}
            </span>
        {% endif %}
    </div>
    <div class="thread__notification"><span class="thread__notification-legend">{{ lang.notification_method }}</span> <span class="thread__notification-method">{{ thread.notification_type }}</span></div>
    <div class="thread__replies thread__count thread__count--replies">
        <a href="{{ mybb.settings.bburl }}/misc.php?action=whoposted&amp;tid={{ thread.tid }}" onclick="MyBB.whoPosted({{ thread.tid }}); return false;" class="thread__reply-count">{{ thread.replies }}</a>
        <span class="thread__legend">{% if thread.replies == 1 %}{{ lang.reply }}{% else %}{{ lang.replies }}{% endif %}</span>
    </div>
    <div class="thread__views thread__count thread__count--views">
        {{ thread.views }}
        <span class="thread__legend">{% if thread.views == 1 %}{{ lang.view }}{% else %}{{ lang.views }}{% endif %}</span>
    </div>
    <div class="thread__avatar">
        <a href="{{ get_profile_link(thread.lastposteruid) }}" class="avatar-profile-link">
            {{ render_avatar(url=thread.last_poster_avatar, alt=thread.last_poster_name, class='avatar--smallest') }}
        </a>
    </div>
    <div class="thread__latest latest-post">
        <span class="latest-post__text">{{ lang.lastpost_by }}</span>
        <span class="latest-post__author">
            {{ thread.last_poster_link|raw }}
        </span>
        <a href="{{ thread.lastpostlink }}" class="latest-post__date">{{ thread.last_post_date|raw }}</a>
    </div>
    <div class="thread__checkbox">
        <input type="checkbox" class="checkbox checkbox--select-row" name="check[{{ thread.tid }}]" value="{{ thread.tid }}" />
    </div>
</div>
