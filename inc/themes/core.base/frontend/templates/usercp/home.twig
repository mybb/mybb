{% extends 'layouts/account.twig' %}

{% block head %}
    <title>{{ lang.user_cp }} - {{ mybb.settings.bbname }}</title>
{% endblock head %}

{% block accountHeader %}
    <header class="page-header">
        <h1 class="title title--page">{{ lang.account_summary }}</h1>
    </header>
{% endblock accountHeader %}

{% block accountBody %}
    <section class="block block--container account-dashboard">
        <div class="account-dashboard__avatar">
            <a href="{{ get_profile_link(mybb.user.uid) }}" class="avatar-profile-link">
                {{ render_avatar(url=mybb.user.avatar, alt=mybb.user.username, class='avatar--large') }}
            </a>
        </div>
        <ul class="account-dashboard__stats list list--divided list--stats">
            <li class="list__item title">{{ username|raw }}</li>
            <li class="list__item">
                <span class="list__field">{{ lang.postnum }}</span>
                <span class="list__value"><a href="search.php?action=finduser&amp;uid={{ mybb.user.uid }}">{{ mybb.user.posts }}</a> {{ lang.posts_day }}</span>
            </li>
            {% if mybb.usergroup.usereputationsystem and mybb.settings.enablereputation %}
                <li class="list__item">
                    <span class="list__field">{{ lang.reputation }}</span>
                    <span class="list__value">{{ reputation_link|raw }} [<a href="reputation.php?uid={{ mybb.user.uid }}">{{ lang.details }}</a>]</span>
                </li>
            {% endif %}
            <li class="list__item">
                <span class="list__field">{{ lang.email }}</span>
                <span class="list__value">{{ mybb.user.email }}</span>
            </li>
            <li class="list__item">
                <span class="list__field">{{ lang.registration_date }}</span>
                <span class="list__value">{{ mybb.user.regdate|raw }}</span>
            </li>
            <li class="list__item">
                <span class="list__field">{{ lang.primary_usergroup }}</span>
                <span class="list__value">{{ groupscache[mybb.user.usergroup].title }} {% if mybb.user.usergroup == 5 and mybb.settings.regtype != 'admin' %}(<a href="member.php?action=resendactivation">{{ lang.resend_activation }}</a>){% endif %}</span>
            </li>
            {% if mybb.settings.usereferrals %}
                <li class="list__item">
                    <span class="list__field">{{ lang.members_referred }}</span>
                    <span class="list__value"> {{ mybb.user.referrals }}<br />
                    {{ trans('referral_link', mybb.settings.bburl, mybb.user.uid) }}</span>
                </li>
            {% endif %}
        </ul>
    </section>
    {# Latest subscribed #}
    {% if latestsubscriptions %}
        <section class="block block--thread-list">
            <h1 class="title title--major title">{{ lang.new_thread_subscriptions }}</h1>
            <div class="column-headings column-headings--minor column-headings--thread-list thread thread--compact">
                <div class="column-headings__column thread__title">{{ lang.thread }}</div>
                <div class="column-headings__column thread__author">{{ lang.author }}</div>
                <div class="column-headings__column thread__replies">{{ lang.replies }}</div>
                <div class="column-headings__column thread__latest">{{ lang.lastpost }}</div>
            </div>
            <div class="thread-list thread-list--compact">
                {% for thread in latestsubscriptions %}
                    {% include 'usercp/home/thread.twig' %}
                {% endfor %}
            </div>
            <div class="block__footer">
                <a href="usercp.php?action=subscriptions" class="button button--basic button--inline">
                    {{ include('partials/icon.twig', {icon: 'plus', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.view_all_subscriptions }}</span>
                </a>
            </div>
        </section>
    {% endif %}

    {# Latest threads #}
    {% if latestthreads %}
        <section class="block block--thread-list">
            <h1 class="title title--major">{{ lang.latest_threads }}</h1>
            <div class="column-headings column-headings--minor column-headings--thread-list thread thread--compact">
                <div class="column-headings__column thread__title">{{ lang.thread }}</div>
                <div class="column-headings__column thread__author">{{ lang.author }}</div>
                <div class="column-headings__column thread__replies">{{ lang.replies }}</div>
                <div class="column-headings__column thread__latest">{{ lang.lastpost }}</div>
            </div>
            <div class="thread-list">
                {% for thread in latestthreads %}
                    {% include 'usercp/home/thread.twig' %}
                {% endfor %}
            </div>
            <div class="block__footer">
                <a href="search.php?action=finduserthreads&amp;uid={{ mybb.user.uid }}" class="button button--inline button--basic">
                    {{ include('partials/icon.twig', {icon: 'comments', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.find_all_threads }}</span>
                </a>
            </div>
        </section>
    {% endif %}

    {# Warnings #}
    {% if warnings %}
        <section class="block">
            <h1 class="title title--major">{{ lang.latest_warnings }} - {{ lang.current_warning_level|raw }}</h1>
            {% for warning in warnings %}
                <div class="row row--simple-columns warning-log">
                    <div class="row__primary">
                        <div class="warning-log__warning">{{ warning.type }} {{ warning.points }}</div>
                        {% if warning.post_subject %}
                            <div class="warning-log__post">{{ lang.warning_for_post }} <a href="{{ warning.postlink }}">{{ warning.post_subject }}</a></div>
                        {% endif %}
                        <div class="warning-log__expiry-date">
                            {{ lang.expires }}:
                            {{ warning.expiration }}
                        </div>
                        {% if warning.requiresacknowledgement %}
                            <div class="warning-log__acknowledgement">
                                {{ lang.acknowledged }}:
                                {% if warning.acknowledged %}
                                    <span class="warning-log__acknowledgement-date">{{ warning.acknowledged|my_date }}</span>
                                {% else %}
                                    <span class="warning-log__acknowledgement--bad">{{ lang.no }}</span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                    <div class="row__secondary">
                        {% if warning.requiresacknowledgement and not warning.acknowledged and not warning.daterevoked %}
                            <form action="usercp.php" method="post" name="input">
                                <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}" />
                                <input type="hidden" name="action" value="do_acknowledge" />
                                <input type="hidden" name="wid" value="{{ warning.wid }}" />
                                <div class="warning-log__details">
                                    <button class="button button--medium" type="submit">
                                        {{ include('partials/icon.twig', {icon: 'check', class: 'button__icon'}, with_context = false) }}
                                        <span class="button__text">{{ lang.acknowledge }}</span>
                                    </button>
                                </div>
                            </form>
                        {% endif %}
                        <div class="warning-log__issued_by">{{ lang.issued_by }} {{ warning.issuedby|raw }}</div>
                        <div class="warning-log__issued-date">{{ warning.date_issued|raw }}</div>
                    </div>
                </div>
            {% endfor %}
        </section>
    {% endif %}

    <section class="block block--form form">
        <form action="usercp.php" method="post">
            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}" />
            <div class="section section--form">
                <div class="row row--form field">
                    <h3 class="field__name"><label for="notepad">{{ lang.personal_notepad }}</label></h3>
                    <textarea name="notepad" cols="1" rows="10" id="notepad" class="usercp_notepad">{{ mybb.user.notepad }}</textarea>
                </div>
            </div>
            <div class="block__footer">
                <input type="hidden" name="action" value="do_notepad" />
                <button type="submit" class="button" name="submit">
                    {{ include('partials/icon.twig', {icon: 'sticky-note', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.update_notepad }}</span>
                </button>
            </div>
        </form>
    </section>

{% endblock accountBody %}
