<section class="section section--form compose__hidden-section compose__hidden-section--attachments upload-attachments">
    <h2 class="title title--section">{{ lang.attachments }}</h2>
    <div class="section__container">
        <div class="row row--form row--information field upload-attachments__quota">{{ lang.attach_quota }} {{ lang.attach_usage|raw }} <a href="usercp.php?action=attachments">{{ lang.view_attachments }}</a></div>
        <div class="upload-attachments__attachments">
            {% for attachment in attachments %}
                {{ include('misc/attachments_attachment.twig') }}
            {% endfor %}
        </div>
        {% if composepost.showattachoptions %}
        <div class="row row--form field">
            <h3 class="field__name">{{ lang.new_attachment }}</h3>
            <div class="file-wrapper">
                <input type="file" name="attachments[]" size="30" class="fileupload" multiple="multiple" />
            </div>
            {% if composepost.showattachadd %}
                <button type="submit" class="button button--full-width" name="newattachment" value="new">
                    {{ include('partials/icon.twig', {icon: 'upload', class: 'button__icon'}, with_context = false) }}
                    <span class="button__text">{{ lang.add_attachment }}</span>
                </button>
            {% endif %}
            {% if composepost.showattachupdate %}
            <button type="submit" class="button button--full-width button--secondary" name="updateattachment" value="update">
                {{ include('partials/icon.twig', {icon: 'paperclip', class: 'button__icon'}, with_context = false) }}
                <span class="button__text">{{ lang.update_attachment }}</span>
            </button>
            {% endif %}
        </div>
        {% endif %}
        <div class="row row--form field">
            <div id="dropzone" class="upload-attachments__drop-zone">
                <div class="upload-attachments__pointer-events"></div>
            </div>
            <div id="upload_bar" class="upload-attachments__upload-bar"></div>
        </div>
    </div>
</section>
