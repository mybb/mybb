{% extends 'layouts/master.twig' %}

{% block head %}
    <title>{{ lang.search_results }} - {{ mybb.settings.bbname }}</title>
{% endblock head %}

{% block body %}
<div class="page-content">
    <header class="page-header">
        <h1 class="title title--page">{{ lang.search_results }}</h1>
    </header>
    <div class="page-controls page-controls--compact">{{ multipage|raw }}</div>

    <section class="block block--thread-list">
        {% set ascDesc %}
            <span class="sort-results__order">
                {% if results.oppsort == 'desc' %}
                    {{ include('partials/icon.twig', {icon: 'chevron-circle-up', class: '', title: results.oppsort}, with_context = false) }}
                {% else %}
                    {{ include('partials/icon.twig', {icon: 'chevron-circle-down', class: '', title: results.oppsort}, with_context = false) }}
                {% endif %}
            </span>
        {% endset %}
        <div class="column-headings column-headings--major column-headings--thread-list sort-results thread thread--search-posts">
            <div class="column-headings__column thread__title">
                <a href="search.php?action=results&amp;sid={{ results.sid }}&amp;sortby=subject&amp;order={% if results.orderarrow.subject %}{{ results.oppsortnext }}{% else %}asc{% endif %}" class="sort-results__link sort-results__link--title">{{ lang.thread }}{% if results.orderarrow.subject %}{{ ascDesc }}{% endif %}</a>
            </div>
            <div class="column-headings__column thread__forum">
                <a href="search.php?action=results&amp;sid={{ results.sid }}&amp;sortby=forum&amp;order={% if results.orderarrow.forum %}{{ results.oppsortnext }}{% else %}asc{% endif %}" class="sort-results__link sort-results__link--forum">{{ lang.forum }}{% if results.orderarrow.forum %}{{ ascDesc }}{% endif %}</a>
            </div>
            <div class="column-headings__column thread__replies">
                <a href="search.php?action=results&amp;sid={{ results.sid }}&amp;sortby=replies&amp;order={% if results.orderarrow.replies %}{{ results.oppsortnext }}{% else %}desc{% endif %}" class="sort-results__link sort-results__link--replies">{{ lang.replies }}{% if results.orderarrow.replies %}{{ ascDesc }}{% endif %}</a>
            </div>
            <div class="column-headings__column thread__latest">
                <a href="search.php?action=results&amp;sid={{ results.sid }}&amp;sortby=starter&amp;order={% if results.orderarrow.starter %}{{ results.oppsortnext }}{% else %}asc{% endif %}" class="sort-results__link sort-results__link--author">{{ lang.author }}{% if results.orderarrow.starter %}{{ ascDesc }}{% endif %}</a>
                <a href="search.php?action=results&amp;sid={{ results.sid }}&amp;sortby=dateline&amp;order={% if results.orderarrow.dateline %}{{ results.oppsortnext }}{% else %}desc{% endif %}" class="sort-results__link sort-results__link--latest">{{ lang.posted }}{% if results.orderarrow.dateline %}{{ ascDesc }}{% endif %}</a>
            </div>
            {% if results.show_inline_moderation %}
                <div class="column-headings__column thread__checkbox">
                    <input type="checkbox" name="allbox" onclick="inlineModeration.checkAll(this);" />
                </div>
            {% endif %}
        </div>
        {% if results.show_inline_moderation %}
            <div class="thread-list__select-all" id="selectAllrow">
                {{ lang.page_selected|raw }} <a href="javascript:void(0)" onclick='inlineModeration.selectAll(); return false;'>{{ lang.select_all|raw }}</a>
            </div>
            <div class="thread-list__select-all" id="allSelectedrow">
                {{ lang.all_selected|raw }} <a href="javascript:void(0)" onclick='inlineModeration.clearChecked(); return false;'>{{ lang.clear_selection|raw }}</a>
            </div>
        {% endif %}
        <div class="thread-list thread-list--search-posts">
            {% for post in posts %}
                {% include 'search/results_posts_row.twig' %}
            {% endfor %}
        </div>

        {% if results.show_inline_moderation %}
        <form action="moderation.php" method="post" style="margin-top: 0; margin-bottom: 0;">
            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}" />
            <input type="hidden" name="tid" value="0" />
            <input type="hidden" name="searchid" value="{{ results.sid }}" />
            <input type="hidden" name="modtype" value="inlinepost" />
            <div class="block__footer block-actions block-actions--extra-space">
                <h3 class="block-actions__title">{{ lang.inline_thread_moderation }}</h3>
                {{ asset('jscripts/inline_moderation.js', static=true) }}
                <div class="select-field">
                    {{ include('partials/icon.twig', {icon: 'sort', class: 'select-field__icon'}, with_context = false) }}
                    <select name="action">
                        <optgroup label="{{ lang.standard_mod_tools }}">
                            <option value="multisoftdeleteposts">{{ lang.inline_soft_delete_posts }}</option>
                            <option value="multirestoreposts">{{ lang.inline_restore_posts }}</option>
                            <option value="multideleteposts">{{ lang.inline_delete_posts }}</option>
                            <option value="multimergeposts">{{ lang.inline_merge_posts }}</option>
                            <option value="multisplitposts">{{ lang.inline_split_posts }}</option>
                            <option value="multimoveposts">{{ lang.inline_move_posts }}</option>
                            <option value="multiapproveposts">{{ lang.inline_approve_posts }}</option>
                            <option value="multiunapproveposts">{{ lang.inline_unapprove_posts }}</option>
                        </optgroup>
                        {% if results.show_inline_moderation %}
                            <optgroup label="{{ lang.custom_mod_tools }}">
                                {% for tool in results.customposttools %}
                                    <option value="{{ tool.tid }}">{{ tool.name }}</option>
                                {% endfor %}
                            </optgroup>
                        {% endif %}
                    </select>
                </div>
                <input type="submit" class="button button--inline" name="go" value="{{ lang.inline_go }} ({{ results.inlinecount }})" id="inline_go" /> {# TO DO: Change to button with icon (JS for counter must be fixed first) #}
                <input type="button" onclick="inlineModeration.clearChecked();" value="{{ lang.clear }}" class="button button--secondary button--inline" />
            </div>
            <input type="hidden" name="url" value="{{ results.return_url }}" />
            <input type="hidden" name="inlinetype" value="search" />
            </form>
            <script type="text/javascript">
            <!--
                var go_text = "{{ lang.inline_go }}";
                var all_text = "{{ results.postcount }}";
                var inlineType = "search";
                var inlineId = '{{ results.sid }}';
            // -->
            </script>
        {% endif %}
    </section>

    {{ multipage|raw }}
</div>
{% endblock body %}
