{% if post.visible == 0 %}
    {% set row = 'trow_shaded' %}
{% elseif post.visible == -1 %}
    {% set row = 'trow_shaded trow_deleted' %}
{% endif %}
<div class="row row--thread thread thread--search-posts {{ row }} inline_row">
    <div class="thread__title">
        <h3 class="thread__subject">
            <a href="{{ post.post_url|raw }}#pid{{ post.pid }}">{{ lang.post }}</a> {{ lang.in }} <a href="{{ post.thread_url|raw }}">{{ post.thread_subject }}</a>

            {% if post.unread %}
                <a href="{{ post.post_url|raw }}#pid{{ post.pid }}" class="thread__jump">
                    {{ include('partials/icon.twig', {icon: 'circle', class: '', title: lang.goto_post }, with_context = false) }}
                </a>
            {% endif %}
        </h3>
    </div>
    {% if post.hasicon %}
        <div class="thread__icons">
            <span class="thread__icon">
                {% if post.icon_class %}
                    {{ include('partials/icon.twig', {icon: post.icon_class, class: '', title: post.icon_name}, with_context = false) }}
                {% elseif post.icon_path %}
                    <img src="{{ post.icon_path }}" alt="{{ post.icon_name }}" title="{{ post.icon_name }}" />
                {% endif %}
            </span>
        </div>
    {% endif %}
    <div class="thread__forum">{{ lang.post_forum }} <a href="{{ post.forumlink_link }}">{{ post.forumlink_name }}</a></div>
    <div class="thread__message">{{ post.message|slice(0, 200) }}{% if post.message|length > 200 %}...{% endif %}</div>
    <div class="thread__replies thread__count thread__count--replies">
        <a href="{{ mybb.settings.bburl }}/misc.php?action=whoposted&amp;tid={{ post.tid }}" onclick="MyBB.whoPosted({{ post.tid }}); return false;" class="thread__reply-count">{{ post.thread_replies }}</a>
        <span class="thread__legend">{% if post.thread_replies == 1 %}{{ lang.reply }}{% else %}{{ lang.replies2 }}{% endif %}</span>
    </div>
    <div class="thread__views thread__count thread__count--views">
        {{ post.thread_views }}
        <span class="thread__legend">{% if thread.views == 1 %}{{ lang.view }}{% else %}{{ lang.views }}{% endif %}</span>
    </div>
    <div class="thread__avatar">
        <a href="{{ get_profile_link(post.uid) }}" class="avatar-profile-link">
            {{ render_avatar(url=post.user_avatar, alt=post.username, class='avatar--smallest') }}
        </a>
    </div>
    <div class="thread__latest latest-post">
        <span class="latest-post__text">{{ lang.posted_by }}</span>
        <span class="latest-post__author">
            {% if post.uid > 0 %}
                <a href="{{ get_profile_link(post.uid) }}">{{ post.uid|format_name }}</a>
            {% else %}
                {{ post.username ?? lang.guest }}
            {% endif %}
        </span>
        <a href="{{ post.post_url|raw }}#pid{{ post.pid }}" class="latest-post__date">{{ post.posted|raw }}</a>
    </div>
    {% if post.show_mod_checkbox %}
    <div class="thread__checkbox">
        <input type="checkbox" class="checkbox checkbox--select-row" name="inlinemod_{{ post.pid }}" id="inlinemod_{{ post.pid }}" value="1"{% if post.checked %} checked{% endif %} />
    </div>
    {% endif %}
</div>
