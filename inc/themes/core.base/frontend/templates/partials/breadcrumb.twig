<div class="breadcrumb{% if class %} {{ class }}{% endif %}">
    {% for crumb in breadcrumbs %}
        {# Separator #}
        {% if loop.first != true and loop.last != true %}
            {# Not used #}
        {% elseif loop.last and loop.length > 1 %}
            {# Not used #}
        {% endif %}

        {# Breadcrumb bit #}
        {% if loop.last %}
            <span class="breadcrumb__active">{{ crumb.name|raw }}</span>
        {% else %}
            <a href="{{ crumb.url|remove_page_one|raw }}" class="breadcrumb__link"><span class="breadcrumb__text">{{ crumb.name }}</span></a>
            {% if crumb.multipage is defined and not empty %}
                {% if not mybb.settings.threadsperpage or mybb.settings.threadsperpage < 1 %}
                    {% set perPage = 20 %}
                {% else %}
                    {% set perPage = mybb.settings.threadsperpage %}
                {% endif %}
                {% if crumb.multipage.num_threads > perPage %}
                    <details class="breadcrumb__multipage">
                        <summary class="breadcrumb__multipage-link">
                            {{ include('partials/icon.twig', {icon: 'caret-down', class: 'breadcrumb__caret'}, with_context = false) }}
                        </summary>
                        {{ multi_page(crumb.multipage.num_threads, perPage,
                        crumb.multipage.current_page, crumb.multipage.url, true) }}
                    </details>
                {% endif %}
            {% endif %}
            {{ include('partials/icon.twig', {icon: 'chevron-right', class: 'breadcrumb__separator'}, with_context = false) }}
        {% endif %}
    {% endfor %}
</div>
