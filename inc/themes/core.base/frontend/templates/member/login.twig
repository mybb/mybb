{% extends 'layouts/master.twig' %}

{% block head %}
    <title>{{ lang.login }} - {{ mybb.settings.bbname }}</title>
{% endblock head %}

{% block body %}
    <div class="page-content page-content--centered">
        <header class="page-header">
            <h1 class="title title--page">{{ lang.login }}</h1>
            {% if mybb.input.send_magic_link == 1 and mybb.settings.enable_magic_login == 1 %}
                <p class="page-description">{{ lang.login_description_magic_link }}</p>
            {% endif %}
       </header>
        {{ inline_errors|raw }}
        {% if mybb.user.uid %}
            <div class="alert">
                <div class="alert__message">{{ lang.already_logged_in|raw }}</div>
            </div>
        {% endif %}
        <form action="member.php" method="post">
            <section class="block block--form form">
                <div class="section section--form">
                    {% if mybb.input.send_magic_link == 1 and mybb.settings.enable_magic_login == 1 %}
                        <div class="row row--form field">
                            <h3 class="field__name"><label for="email">{{ lang.email }}</label></h3>
                            <input type="email" class="textbox" name="email" id="email" autocomplete="email" value="{{ login.email }}" tabindex="1" required>
                        </div>
                    {% else %}
                        <div class="row row--form field">
                            <h3 class="field__name"><label for="username">{{ lang.username }}</label></h3>
                            <input type="text" class="textbox" name="username" id="username" autocomplete="username" value="{{ login.username }}" tabindex="1" required autofocus>
                        </div>
                        <div class="row row--form field">
                            <h3 class="field__name"><label for="password">{{ lang.password }}</label></h3>
                            <p class="field__description"><a href="member.php?action=lostpw">{{ lang.lostpw_note }}</a></p>
                            <input type="password" class="textbox" name="password" id="password" autocomplete="current-password" value="{{ login.password }}" tabindex="2" required>
                        </div>
                    {% endif %}
                    <div class="row row--form row--compact field">
                        <p class="option-field option-field--compact">
                            <label title="{{ lang.remember_me_desc }}"><input type="checkbox" class="checkbox" name="remember" checked="checked" value="yes" /> {{ lang.remember_me }}</label>
                        </p>
                    </div>
                    {% if mybb.settings.enable_magic_login == 1 %}
                        <div class="row row--form">
                            <a href="{{ url('member.php', { 'action': 'login', 'send_magic_link': 1 }) }}"
                               class="button button--inline button--small">{{ lang.login_with_email_link }}</a>
                        </div>
                    {% endif %}
                    {{ captcha|raw }}
                </div>
                <div class="block__footer">
                    <button type="submit" class="button button--big">
                        {{ include('partials/icon.twig', {icon: 'sign-in-alt', class: 'button__icon'}, with_context = false) }}
                        <span class="button__text">{{ lang.login }}</span>
                    </button>
                </div>
            </section>
            {% if mybb.input.send_magic_link == 1 and mybb.settings.enable_magic_login == 1 %}
                <input type="hidden" name="send_magic_link" value="1" />
                <input type="hidden" name="action" value="send_magic_link" />
            {% else %}
                <input type="hidden" name="action" value="do_login" />
            {% endif %}
            <input type="hidden" name="url" value="{{ login.redirect_url }}" />
            <input type="hidden" name="my_post_key" value="{{ mybb.post_code }}" />
        </form>
    </div>
{% endblock body %}
