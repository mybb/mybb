<div class="forum__latest">
    <div class="latest-post">
        <div class="latest-post__avatar">
            <a href="{{ get_profile_link(forum.last_post.lastposteruid) }}" class="avatar-profile-link">
                {{ render_avatar(url=forum.last_post.last_poster_avatar_url, alt=forum.last_post.lastposter, class='avatar--small') }}
            </a>
        </div>
        <div class="latest-post__details">
            <h4 class="latest-post__subject"><a href="{{ forum.last_post.link|raw }}" title="{{ forum.last_post.full_subject }}">{{ forum.last_post.subject }}</a></h4>
            <div class="latest-post__date">{{ forum.last_post.date|raw }}</div>
            <div class="latest-post__author">{{ lang.by }} {{ forum.last_post.profile_link|raw }}</div>
        </div>
    </div>
</div>
